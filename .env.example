NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DEMO_MODE=true

# Production requires PostgreSQL and a real identity provider adapter.
DATABASE_URL=
DATABASE_SSL=false
SESSION_SECRET=
REPORT_SIGNING_SECRET=
REPORT_STORAGE_DIR=./reports

# Testnet endpoints verified against the official public ME testnet.
NETWORK_ID=mechain_400-1
TESTNET_RPC_URL=https://beta-hub-26657.explorer-testnet.me
TESTNET_REST_URL=https://beta-hub-1317.explorer-testnet.me
# User-provided candidate; DNS resolution did not succeed during verification.
TESTNET_GRPC_URL=https://beta-da-9090.explorer-testnet.me:9090
INDEX_START_HEIGHT=
INDEX_CONFIRMATIONS=1
INDEX_POLL_MS=4000

# ME PASS partner authorization is documented, but no API origin or end-user
# authorization handoff is verified. Do not configure credentials yet.

# No verified mainnet node endpoint was found. Keep blank until confirmed by Meta Earth.
MAINNET_CHAIN_ID=
MAINNET_RPC_URL=
MAINNET_REST_URL=

# Payments stay off until a destination/contract and verifier are approved.
MEC_PAYMENT_ENABLED=false
MEC_PAYMENT_NETWORK=
MEC_PAYMENT_RECIPIENT=
MEC_DAILY_SUBSCRIPTION_PRICE=
MEC_REPORT_PRICE=0.01

# Optional admin subject IDs from verified identity claims; never from a client header.
ADMIN_SUBJECTS=
